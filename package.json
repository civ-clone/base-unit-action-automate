{
  "name": "@civ-clone/base-unit-action-automate",
  "version": "0.1.0",
  "description": "The Automate unit action: a standing order for a worker to improve the terrain around its player's cities by itself, using the game's TerrainWork strategy.",
  "main": "index.js",
  "repository": "git@github.com:civ-clone/base-unit-action-automate.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/civ1-unit": "github:civ-clone/civ1-unit",
    "@civ-clone/civ1-world": "github:civ-clone/civ1-world",
    "@civ-clone/core-city": "^0.1.19",
    "@civ-clone/core-civilization": "^0.1.7",
    "@civ-clone/core-player-world": "^0.1.13",
    "@civ-clone/core-save-game": "^0.1.13",
    "@civ-clone/core-tile-improvement": "^0.1.0",
    "@civ-clone/simple-world-generator": "github:civ-clone/simple-world-generator",
    "@civ-clone/simple-world-path": "github:civ-clone/simple-world-path",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-strategy-ai": "^0.1.0",
    "@civ-clone/base-strategy-terrain-work": "^0.1.0",
    "@civ-clone/core-data-object": "^0.1.17",
    "@civ-clone/core-game": "^0.1.8",
    "@civ-clone/core-pending-effect": "^0.1.2",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.6",
    "@civ-clone/core-strategy": "^0.1.6",
    "@civ-clone/core-unit": "^0.1.26",
    "@civ-clone/core-world": "^0.1.18",
    "@civ-clone/core-world-path": "^0.1.2"
  }
}
